#usda 1.0
(
    defaultPrim = "Mover"
    startTimeCode = 0
    endTimeCode = 4
    timeCodesPerSecond = 4
    upAxis = "Y"
    metersPerUnit = 1
)

# An animated parent with a static child, with answers worked out by hand
# (SkeletalAnimationTests): over one second Mover slides 2 along x and turns 90° about z.
# The child Box sits 1 above Mover, so its vertex at (1, 0, 0) swings with the turn.
def Xform "Mover"
{
    double3 xformOp:translate.timeSamples = {
        0: (0, 0, 0),
        4: (2, 0, 0),
    }
    float xformOp:rotateZ.timeSamples = {
        0: 0,
        4: 90,
    }
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

    def Mesh "Box"
    {
        double3 xformOp:translate = (0, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(1, 0, 0), (0, 0, 0), (0, 0, 1)]
    }
}
