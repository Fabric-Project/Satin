#usda 1.0
(
    defaultPrim = "Root"
    upAxis = "Y"
    metersPerUnit = 1
)

# LoaderTests, merging static meshes: meshes merge only when nothing about how they draw differs.
# - P (under Left), Q (under Right) and R share Red and the identity world transform: one mesh.
#   Z, Y's child, has that world transform too and joins them; Y has a child, so it stays.
# - S uses Red under a translation: another world transform, it stays.
# - T uses Blue, the only mesh that does: a group of one, it stays as loaded.
# - U uses Red but is double-sided: another cull mode, it stays.
# - V and W use Glass, which blends: transparent meshes never merge.
# - X uses Red under an animated rotation: it moves, so it stays.
# Every quad faces +Z.
def Xform "Root"
{
    def Scope "Looks"
    {
        def Material "Red"
        {
            token outputs:surface.connect = </Root/Looks/Red/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0, 0)
                token outputs:surface
            }
        }

        def Material "Blue"
        {
            token outputs:surface.connect = </Root/Looks/Blue/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 1)
                token outputs:surface
            }
        }

        def Material "Glass"
        {
            token outputs:surface.connect = </Root/Looks/Glass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 1, 0)
                float inputs:opacity = 0.5
                token outputs:surface
            }
        }
    }

    def Xform "Left"
    {
        def Mesh "P" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 0
            int[] faceVertexCounts = [3, 3]
            int[] faceVertexIndices = [0, 1, 2, 2, 1, 3]
            point3f[] points = [(-3.0, -0.5, 0), (-2.2, -0.5, 0), (-3.0, 0.5, 0), (-2.2, 0.5, 0)]
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (0, 1), (1, 1)] (
                interpolation = "vertex"
            )
            rel material:binding = </Root/Looks/Red>
        }
    }

    def Xform "Right"
    {
        def Mesh "Q" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 0
            int[] faceVertexCounts = [3, 3]
            int[] faceVertexIndices = [0, 1, 2, 2, 1, 3]
            point3f[] points = [(-2.0, -0.5, 0), (-1.2, -0.5, 0), (-2.0, 0.5, 0), (-1.2, 0.5, 0)]
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (0, 1), (1, 1)] (
                interpolation = "vertex"
            )
            rel material:binding = </Root/Looks/Red>
        }
    }

    def Mesh "R" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 0
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 2, 2, 1, 3]
        point3f[] points = [(-1.0, -0.5, 0), (-0.2, -0.5, 0), (-1.0, 0.5, 0), (-0.2, 0.5, 0)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (0, 1), (1, 1)] (
            interpolation = "vertex"
        )
        rel material:binding = </Root/Looks/Red>
    }

    def Xform "Moved"
    {
        double3 xformOp:translate = (0, 1.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Mesh "S" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 0
            int[] faceVertexCounts = [3, 3]
            int[] faceVertexIndices = [0, 1, 2, 2, 1, 3]
            point3f[] points = [(-3.0, -0.5, 0), (-2.2, -0.5, 0), (-3.0, 0.5, 0), (-2.2, 0.5, 0)]
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (0, 1), (1, 1)] (
                interpolation = "vertex"
            )
            rel material:binding = </Root/Looks/Red>
        }
    }

    def Mesh "T" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 0
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 2, 2, 1, 3]
        point3f[] points = [(0.0, -0.5, 0), (0.8, -0.5, 0), (0.0, 0.5, 0), (0.8, 0.5, 0)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (0, 1), (1, 1)] (
            interpolation = "vertex"
        )
        rel material:binding = </Root/Looks/Blue>
    }

    def Mesh "U" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 1
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 2, 2, 1, 3]
        point3f[] points = [(1.0, -0.5, 0), (1.8, -0.5, 0), (1.0, 0.5, 0), (1.8, 0.5, 0)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (0, 1), (1, 1)] (
            interpolation = "vertex"
        )
        rel material:binding = </Root/Looks/Red>
    }

    def Mesh "V" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 0
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 2, 2, 1, 3]
        point3f[] points = [(-3.0, -0.5, 0.1), (-2.2, -0.5, 0.1), (-3.0, 0.5, 0.1), (-2.2, 0.5, 0.1)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (0, 1), (1, 1)] (
            interpolation = "vertex"
        )
        rel material:binding = </Root/Looks/Glass>
    }

    def Mesh "W" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 0
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 2, 2, 1, 3]
        point3f[] points = [(-2.0, -0.5, 0.1), (-1.2, -0.5, 0.1), (-2.0, 0.5, 0.1), (-1.2, 0.5, 0.1)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (0, 1), (1, 1)] (
            interpolation = "vertex"
        )
        rel material:binding = </Root/Looks/Glass>
    }

    def Xform "Spinning"
    {
        float xformOp:rotateZ.timeSamples = {
            0: 0,
            1: 90,
        }
        uniform token[] xformOpOrder = ["xformOp:rotateZ"]
        def Mesh "X" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 0
            int[] faceVertexCounts = [3, 3]
            int[] faceVertexIndices = [0, 1, 2, 2, 1, 3]
            point3f[] points = [(2.0, -0.5, 0), (2.8, -0.5, 0), (2.0, 0.5, 0), (2.8, 0.5, 0)]
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (0, 1), (1, 1)] (
                interpolation = "vertex"
            )
            rel material:binding = </Root/Looks/Red>
        }
    }

    def Mesh "Y" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 0
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 2, 2, 1, 3]
        point3f[] points = [(-1.0, -1.5, 0), (-0.2, -1.5, 0), (-1.0, -0.7, 0), (-0.2, -0.7, 0)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (0, 1), (1, 1)] (
            interpolation = "vertex"
        )
        rel material:binding = </Root/Looks/Red>

        def Mesh "Z" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 0
            int[] faceVertexCounts = [3, 3]
            int[] faceVertexIndices = [0, 1, 2, 2, 1, 3]
            point3f[] points = [(0.0, -1.5, 0), (0.8, -1.5, 0), (0.0, -0.7, 0), (0.8, -0.7, 0)]
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (0, 1), (1, 1)] (
                interpolation = "vertex"
            )
            rel material:binding = </Root/Looks/Red>
        }
    }
}
